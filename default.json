{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate rules for snap repositories",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "assignAutomerge": true,
  "customManagers": [
    {
      "customType": "jsonata",
      "description": "Update version from the part using SNAPCRAFT_PROJECT_VERSION",
      "fileFormat": "yaml",
      "managerFilePatterns": ["snap/snapcraft.yaml"],
      "matchStrings": [
        "$.{'depName': parts.*[$contains(`source-tag`, 'SNAPCRAFT_PROJECT_VERSION')].source ~> $substringAfter('https://github.com/') ~> $replace(/\\.git$/, ''), 'currentValue': version}"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Merge upstream release updates after checks pass",
      "matchManagers": ["custom.jsonata"],
      "matchFileNames": ["snap/snapcraft.yaml"],
      "automerge": true
    }
  ]
}
