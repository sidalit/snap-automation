{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate rules for snap repositories",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "assignAutomerge": true,
  "customManagers": [
    {
      "customType": "jsonata",
      "description": "Update the snap version from the repository's configured upstream",
      "fileFormat": "yaml",
      "managerFilePatterns": ["snap/snapcraft.yaml"],
      "matchStrings": [
        "$.{'currentValue': version}"
      ],
      "depNameTemplate": "upstream",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Merge upstream release updates after checks pass",
      "matchDepNames": ["upstream"],
      "commitMessageTopic": "{{{packageName}}}",
      "automerge": true
    }
  ]
}
